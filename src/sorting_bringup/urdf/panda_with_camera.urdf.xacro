<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">

  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:include filename="$(find moveit_resources_panda_moveit_config)/config/panda.urdf.xacro"/>

  <!-- World link — root of the entire tree -->
  <link name="world"/>

  <!-- Connect world to panda base — replaces static_transform_publisher -->
  <joint name="world_to_panda" type="fixed">
    <parent link="world"/>
    <child link="panda_link0"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- Camera mount — bird's eye view above the table -->
  <link name="camera_mount"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_mount"/>
    <origin xyz="0.5 0.0 1.2" rpy="0.0 1.5708 0.0"/>
  </joint>

  <!-- Camera optical frame -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

</robot>